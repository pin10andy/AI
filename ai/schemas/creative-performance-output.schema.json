{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Creative Performance Interpretation Output",
  "description": "素材成效解讀報告。v1.2 新增 input data sufficiency 分層判讀、observe 子類別、candidate pipeline automation 欄位，以及顯式 angle taxonomy handoff。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "interpretation_id",
    "brand_name",
    "product_name",
    "campaign_type",
    "generated_by",
    "generated_at",
    "angle_taxonomy",
    "data_sufficiency",
    "asset_type_percentiles",
    "asset_decisions",
    "high_value_language",
    "legacy_message_state",
    "next_round_brief_additions",
    "retire_now_assets",
    "new_candidate_assets",
    "compliance_notes"
  ],
  "properties": {
    "interpretation_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-_]*$"
    },
    "brand_name": {
      "type": "string",
      "minLength": 1
    },
    "product_name": {
      "type": "string",
      "minLength": 1
    },
    "campaign_type": {
      "type": "string",
      "enum": ["search_rsa", "pmax"]
    },
    "generated_by": {
      "type": "string",
      "enum": ["claude", "codex", "gemini", "openclaw"]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601"
    },
    "angle_taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "keys"],
      "properties": {
        "version": {
          "type": "string",
          "const": "v1.2"
        },
        "keys": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/angle_key"
          },
          "minItems": 10
        }
      }
    },
    "data_sufficiency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall_verdict",
        "click_layer_verdict",
        "conversion_layer_verdict",
        "placement_layer_verdict",
        "duration_layer_verdict",
        "total_impressions",
        "total_clicks",
        "threshold_used",
        "reporting_context"
      ],
      "properties": {
        "overall_verdict": {
          "type": "string",
          "enum": ["sufficient", "partial", "insufficient"]
        },
        "click_layer_verdict": {
          "type": "string",
          "enum": ["ready", "partial", "missing"]
        },
        "conversion_layer_verdict": {
          "type": "string",
          "enum": ["ready", "partial", "missing"]
        },
        "placement_layer_verdict": {
          "type": "string",
          "enum": ["ready", "partial", "missing"]
        },
        "duration_layer_verdict": {
          "type": "string",
          "enum": ["ready", "partial", "missing"]
        },
        "total_impressions": {
          "type": "integer",
          "minimum": 0
        },
        "total_clicks": {
          "type": "integer",
          "minimum": 0
        },
        "total_asset_level_conversions": {
          "type": "integer",
          "minimum": 0
        },
        "threshold_used": {
          "type": "integer",
          "minimum": 0
        },
        "assets_below_threshold": {
          "type": "integer",
          "minimum": 0
        },
        "reporting_context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "asset_granularity",
            "includes_asset_level_conversion",
            "includes_asset_level_conversion_value",
            "includes_placement_breakout"
          ],
          "properties": {
            "asset_granularity": {
              "type": "string",
              "enum": ["asset_level", "asset_association_estimate", "mixed"]
            },
            "includes_asset_level_conversion": {
              "type": "boolean"
            },
            "includes_asset_level_conversion_value": {
              "type": "boolean"
            },
            "includes_placement_breakout": {
              "type": "boolean"
            }
          }
        },
        "gaps_identified": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "asset_type_percentiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_type",
          "primary_metric",
          "placement_scope",
          "eligible_asset_count",
          "p25",
          "p50",
          "p75"
        ],
        "properties": {
          "asset_type": {
            "type": "string",
            "enum": ["short_headline", "long_headline", "headline", "description"]
          },
          "primary_metric": {
            "type": "string",
            "enum": [
              "association_proxy_only",
              "ctr_asset_type_percentile",
              "conversion_rate_asset_type_percentile",
              "hybrid_asset_type_percentile"
            ]
          },
          "placement_scope": {
            "type": "string",
            "enum": ["overall", "search", "display", "mixed"]
          },
          "eligible_asset_count": {
            "type": "integer",
            "minimum": 0
          },
          "p25": {
            "type": "number",
            "minimum": 0
          },
          "p50": {
            "type": "number",
            "minimum": 0
          },
          "p75": {
            "type": "number",
            "minimum": 0
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "asset_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "text",
          "asset_type",
          "angle_key",
          "decision",
          "decision_rationale",
          "decision_basis",
          "decision_confidence",
          "performance_tier",
          "metrics_summary",
          "active_duration_days",
          "observe_reason",
          "staleness_flag",
          "legacy_tags"
        ],
        "properties": {
          "asset_id": { "type": "string" },
          "text": { "type": "string" },
          "asset_type": {
            "type": "string",
            "enum": ["short_headline", "long_headline", "headline", "description"]
          },
          "angle_key": {
            "$ref": "#/definitions/angle_key"
          },
          "decision": {
            "type": "string",
            "enum": [
              "retain",
              "retire",
              "retire_candidate",
              "reinforce",
              "observe_new",
              "observe_insufficient_data",
              "observe_stale",
              "observe_borderline"
            ]
          },
          "decision_rationale": {
            "type": "string",
            "minLength": 10
          },
          "decision_basis": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "primary_metric",
              "asset_type_cohort",
              "placement_scope",
              "eligible_asset_count",
              "cohort_percentiles",
              "data_layers_used",
              "supporting_metrics_available",
              "placement_breakout_available"
            ],
            "properties": {
              "primary_metric": {
                "type": "string",
                "enum": [
                  "association_proxy_only",
                  "ctr_asset_type_percentile",
                  "conversion_rate_asset_type_percentile",
                  "hybrid_asset_type_percentile"
                ]
              },
              "asset_type_cohort": {
                "type": "string",
                "enum": ["short_headline", "long_headline", "headline", "description"]
              },
              "placement_scope": {
                "type": "string",
                "enum": ["overall", "search", "display", "mixed"]
              },
              "eligible_asset_count": {
                "type": "integer",
                "minimum": 0
              },
              "cohort_percentiles": {
                "type": "object",
                "additionalProperties": false,
                "required": ["p25", "p50", "p75"],
                "properties": {
                  "p25": { "type": "number", "minimum": 0 },
                  "p50": { "type": "number", "minimum": 0 },
                  "p75": { "type": "number", "minimum": 0 }
                }
              },
              "data_layers_used": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "click_layer",
                    "conversion_layer",
                    "placement_layer",
                    "duration_layer",
                    "association_proxy"
                  ]
                }
              },
              "supporting_metrics_available": {
                "type": "array",
                "items": { "type": "string" }
              },
              "placement_breakout_available": {
                "type": "boolean"
              },
              "notes": {
                "type": "string"
              }
            }
          },
          "decision_confidence": {
            "type": "string",
            "enum": ["high", "medium", "low", "directional"]
          },
          "performance_tier": {
            "type": "string",
            "enum": ["top", "mid", "low", "insufficient_data", "stale", "borderline"]
          },
          "metrics_summary": {
            "type": "object",
            "additionalProperties": false,
            "required": ["impressions", "clicks", "ctr", "active_duration_days"],
            "properties": {
              "impressions": { "type": "integer", "minimum": 0 },
              "clicks": { "type": "integer", "minimum": 0 },
              "ctr": { "type": "number", "minimum": 0 },
              "asset_level_conversions": { "type": "integer", "minimum": 0 },
              "conversion_value": { "type": "number", "minimum": 0 },
              "conversion_rate": { "type": "number", "minimum": 0 },
              "cpa": { "type": "number", "minimum": 0 },
              "roas": { "type": "number", "minimum": 0 },
              "active_duration_days": { "type": "integer", "minimum": 0 },
              "placement_breakout_summary": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/placement_metric"
                }
              }
            }
          },
          "active_duration_days": {
            "type": "integer",
            "minimum": 0
          },
          "observe_reason": {
            "type": ["string", "null"]
          },
          "staleness_flag": {
            "type": "boolean"
          },
          "language_patterns_extracted": {
            "type": "array",
            "items": { "type": "string" }
          },
          "legacy_tags": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "protected_phrases_matched",
              "must_include_tokens_matched",
              "reusable_motifs_matched"
            ],
            "properties": {
              "protected_phrases_matched": {
                "type": "array",
                "items": { "type": "string" }
              },
              "must_include_tokens_matched": {
                "type": "array",
                "items": { "type": "string" }
              },
              "reusable_motifs_matched": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "high_value_language": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patterns"],
      "properties": {
        "patterns": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pattern", "angle_key", "evidence", "source_asset_ids", "confidence"],
            "properties": {
              "pattern": { "type": "string" },
              "angle_key": {
                "$ref": "#/definitions/angle_key"
              },
              "evidence": { "type": "string" },
              "source_asset_ids": {
                "type": "array",
                "items": { "type": "string" }
              },
              "confidence": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              }
            }
          }
        }
      }
    },
    "legacy_message_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protected_phrases", "must_include_tokens", "reusable_motifs"],
      "properties": {
        "protected_phrases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["phrase", "min_active_assets", "matched_asset_ids", "status"],
            "properties": {
              "phrase": { "type": "string" },
              "min_active_assets": { "type": "integer", "minimum": 1 },
              "matched_asset_ids": {
                "type": "array",
                "items": { "type": "string" }
              },
              "status": {
                "type": "string",
                "enum": ["covered", "gap", "at_risk"]
              },
              "notes": { "type": "string" }
            }
          }
        },
        "must_include_tokens": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["token", "min_active_assets", "matched_asset_ids", "status"],
            "properties": {
              "token": { "type": "string" },
              "min_active_assets": { "type": "integer", "minimum": 1 },
              "matched_asset_ids": {
                "type": "array",
                "items": { "type": "string" }
              },
              "status": {
                "type": "string",
                "enum": ["covered", "gap", "at_risk"]
              },
              "notes": { "type": "string" }
            }
          }
        },
        "reusable_motifs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["motif_key", "description", "source_assets", "recommendation", "confidence"],
            "properties": {
              "motif_key": { "type": "string" },
              "description": { "type": "string" },
              "source_assets": {
                "type": "array",
                "items": { "type": "string" }
              },
              "recommendation": { "type": "string" },
              "confidence": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              }
            }
          }
        }
      }
    },
    "new_draft_review": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "inherits_from", "legacy_coverage_score", "recommendation"],
        "properties": {
          "text": { "type": "string" },
          "inherits_from": {
            "type": "array",
            "items": { "type": "string" }
          },
          "legacy_coverage_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "recommendation": {
            "type": "string",
            "enum": ["approve", "revise", "reject"]
          },
          "revision_notes": {
            "type": "string"
          }
        }
      }
    },
    "next_round_brief_additions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proven_angles",
        "language_to_avoid",
        "constraints_from_performance",
        "candidate_pipeline_triggers"
      ],
      "properties": {
        "proven_angles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "label", "evidence"],
            "properties": {
              "key": {
                "$ref": "#/definitions/angle_key"
              },
              "label": { "type": "string" },
              "evidence": { "type": "string" }
            }
          }
        },
        "language_to_avoid": {
          "type": "array",
          "items": { "type": "string" }
        },
        "suggested_seed_angles": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/angle_key"
          }
        },
        "constraints_from_performance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protected_phrases",
            "must_include_tokens",
            "reusable_motifs"
          ],
          "properties": {
            "protected_phrases": {
              "type": "array",
              "items": { "type": "string" }
            },
            "must_include_tokens": {
              "type": "array",
              "items": { "type": "string" }
            },
            "reusable_motifs": {
              "type": "array",
              "items": { "type": "string" }
            },
            "cta_preference": {
              "type": "string"
            },
            "tone_adjustments": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "candidate_pipeline_triggers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["gap_id", "angle_key", "rewrite_mode", "priority"],
            "properties": {
              "gap_id": {
                "type": "string"
              },
              "angle_key": {
                "$ref": "#/definitions/angle_key"
              },
              "rewrite_mode": {
                "type": "string",
                "enum": ["retain-intent", "safer-rewrite", "exploratory"]
              },
              "priority": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              },
              "notes": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "retire_now_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "asset_text",
          "asset_type",
          "angle_key",
          "reason",
          "decision_confidence",
          "decision_basis_ref",
          "coverage_gap_created"
        ],
        "properties": {
          "asset_id": { "type": "string" },
          "asset_text": { "type": "string" },
          "asset_type": {
            "type": "string",
            "enum": ["short_headline", "long_headline", "headline", "description"]
          },
          "angle_key": {
            "$ref": "#/definitions/angle_key"
          },
          "reason": {
            "type": "string",
            "minLength": 10
          },
          "decision_confidence": {
            "type": "string",
            "enum": ["high", "medium", "low", "directional"]
          },
          "decision_basis_ref": {
            "type": "string",
            "description": "對應 asset_decisions[].asset_id"
          },
          "coverage_gap_created": {
            "type": "array",
            "items": { "type": "string" }
          },
          "replaced_by_candidate_id": {
            "type": "string"
          }
        }
      }
    },
    "new_candidate_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "asset_text",
          "asset_type",
          "source",
          "angle_key",
          "intent",
          "related_gap",
          "suggested_role",
          "covers_tokens",
          "inherits_motifs",
          "risk_level",
          "rewrite_mode"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "asset_text": {
            "type": "string",
            "minLength": 1
          },
          "asset_type": {
            "type": "string",
            "enum": ["short_headline", "long_headline", "headline", "description"]
          },
          "source": {
            "type": "string",
            "enum": [
              "replace_retired_asset",
              "brief_generator_auto",
              "reinforce_expansion",
              "safer_rewrite"
            ]
          },
          "angle_key": {
            "$ref": "#/definitions/angle_key"
          },
          "intent": {
            "type": "string"
          },
          "related_gap": {
            "type": "string"
          },
          "suggested_role": {
            "type": "string",
            "enum": ["主力", "測試"]
          },
          "covers_tokens": {
            "type": "array",
            "items": { "type": "string" }
          },
          "inherits_motifs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "risk_level": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "rewrite_mode": {
            "type": "string",
            "enum": ["retain-intent", "safer-rewrite", "exploratory"]
          },
          "safer_rewrite_of": {
            "type": "string",
            "description": "若為 safer-rewrite，對應的高風險歷史素材 ID。"
          },
          "source_asset_ids": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "compliance_notes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_caveats",
        "manual_review_required",
        "interpretation_confidence",
        "candidate_pipeline_ready",
        "angle_taxonomy_ready"
      ],
      "properties": {
        "data_caveats": {
          "type": "array",
          "items": { "type": "string" }
        },
        "manual_review_required": {
          "type": "boolean",
          "const": true
        },
        "interpretation_confidence": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "candidate_pipeline_ready": {
          "type": "boolean"
        },
        "angle_taxonomy_ready": {
          "type": "boolean"
        }
      }
    }
  },
  "definitions": {
    "angle_key": {
      "type": "string",
      "enum": [
        "product_feel",
        "risk_reversal",
        "brand_trust",
        "entry_value",
        "life_scene",
        "concrete_number",
        "pain_point",
        "social_proof",
        "legacy_phrase",
        "cta_lower_friction"
      ]
    },
    "placement_metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["placement", "impressions", "clicks", "ctr"],
      "properties": {
        "placement": {
          "type": "string",
          "enum": ["search", "display", "discover", "youtube", "gmail", "other"]
        },
        "impressions": {
          "type": "integer",
          "minimum": 0
        },
        "clicks": {
          "type": "integer",
          "minimum": 0
        },
        "ctr": {
          "type": "number",
          "minimum": 0
        },
        "asset_level_conversions": {
          "type": "integer",
          "minimum": 0
        },
        "conversion_value": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
