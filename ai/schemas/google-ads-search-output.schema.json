{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Google Ads Search RSA Output",
  "description": "Exact output contract for the Search RSA copywriting MVP.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "brief_id",
    "campaign_type",
    "brand_name",
    "product_name",
    "generated_by",
    "generated_at",
    "angles",
    "headlines",
    "descriptions",
    "compliance_notes"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "brief_id": {
      "type": "string",
      "minLength": 1
    },
    "campaign_type": {
      "type": "string",
      "enum": ["search_rsa"]
    },
    "brand_name": {
      "type": "string",
      "minLength": 1
    },
    "product_name": {
      "type": "string",
      "minLength": 1
    },
    "generated_by": {
      "type": "string",
      "enum": ["claude", "codex", "gemini", "openclaw"]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "angles": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label", "rationale"],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "headlines": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "angle_key"],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          },
          "angle_key": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "keyword_used": {
            "type": "boolean"
          },
          "pinned_position": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          }
        }
      }
    },
    "descriptions": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "angle_key"],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 90
          },
          "angle_key": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          }
        }
      }
    },
    "compliance_notes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manual_review_required",
        "checks_passed",
        "policy_risks",
        "brand_risks"
      ],
      "properties": {
        "manual_review_required": {
          "type": "boolean"
        },
        "checks_passed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "policy_risks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "brand_risks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
